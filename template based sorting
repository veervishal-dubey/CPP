#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

template <class T>
void sortArray(T arr[], int n)
{
    for(int i=0;i<n-1;i++)
        for(int j=i+1;j<n;j++)
            if(arr[i] > arr[j])
                swap(arr[i], arr[j]);

    for(int i=0;i<n;i++)
        cout << arr[i] << " ";
}



int main()
{
    int a[4]={1,23,4,123};
    float b[4]={3.14, 6.28, 2.781, 1.596};
    
    sortarray(a,4);
    sortarray(b,4);
    return 0;
}
